{
  "name": "mycards",
  "version": "0.0.1",
  "description": "Android loyalty card app (Capacitor + Angular + Ionic)",
  "author": "APG",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/mdelta/mycards.git"
  },
  "private": true,
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "lint": "npm run eslint && npm run typecheck:e2e && npm run prettier -- --check",
    "lint:fix": "npm run eslint -- --fix && npm run prettier -- --write",
    "eslint": "ng lint --max-warnings 0",
    "prettier": "prettier \"**/*.{ts,html}\"",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "ng test --no-watch",
    "test:coverage": "ng test --no-watch --coverage",
    "test:unit:watch": "ng test --watch",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build:debug": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@angular/common": "22.2.5",
    "@angular/compiler": "22.2.5",
    "@angular/core": "22.2.5",
    "@angular/forms": "22.2.5",
    "@angular/platform-browser": "22.2.5",
    "@angular/router": "22.2.5",
    "@capacitor-community/keep-awake": "8.0.1",
    "@capacitor-community/screen-brightness": "8.0.0",
    "@capacitor-community/sqlite": "8.1.1",
    "@capacitor/android": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@ionic/angular": "^9.0.10",
    "@jsverse/transloco": "^8.4.0",
    "bwip-js": "4.11.4",
    "ionicons": "^8.1.0",
    "jeep-sqlite": "2.8.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.6",
    "@angular/cli": "22.2.6",
    "@angular/compiler-cli": "22.2.5",
    "@angular/language-service": "22.2.5",
    "@capacitor/cli": "^8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "@types/sql.js": "1.4.11",
    "@vitest/coverage-v8": "5.1.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "sql.js": "1.11.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config"
}
